# ==================== Application ====================
APP_NAME=DraftToBlog
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
APP_SECRET_KEY=
APP_PUBLIC_URL=
FRONTEND_PUBLIC_URL=http://127.0.0.1:5173
VITE_API_BASE_URL=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# 0 disables the application-level upload size limit.
MAX_UPLOAD_MB=0
TEMP_DIR=./data/tmp
TASK_TTL_MINUTES=60

# ==================== Official test AI ====================
# Compatible with the OpenAI API format. Keep the key server-side only.
OFFICIAL_AI_ENABLED=false
OFFICIAL_AI_BASE_URL=
OFFICIAL_AI_API_KEY=
OFFICIAL_AI_MODEL=
OFFICIAL_AI_DAILY_REQUEST_LIMIT=100
OFFICIAL_AI_MAX_INPUT_CHARS=30000
OFFICIAL_AI_TIMEOUT_SECONDS=300
OFFICIAL_AI_TRUST_ENV=true
ALLOW_USER_AI_CONFIG=true

# ==================== PicGo ====================
# Example Windows path: C:/Users/you/AppData/Roaming/picgo/config.json
# Example Linux path: /home/deploy/.picgo/config.json
PICGO_BIN=picgo
PICGO_CONFIG_PATH=
# auto uses remote upload first when DEPLOY_* credentials are configured.
# Set to remote to force server-side PicGo/COS uploads.
UPLOAD_PROVIDER=auto

# ==================== Tencent Cloud COS ====================
TENCENT_COS_SECRET_ID=
TENCENT_COS_SECRET_KEY=
TENCENT_COS_BUCKET=
TENCENT_COS_REGION=
TENCENT_COS_PUBLIC_BASE_URL=
TENCENT_COS_PATH_PREFIX=draft-to-blog/
TENCENT_COS_AUTO_DELETE_DAYS=7
TENCENT_COS_UPLOAD_WORKERS=2

# ==================== Cloud deployment ====================
DEPLOY_HOST=
DEPLOY_PORT=22
DEPLOY_USER=
DEPLOY_PASSWORD=
DEPLOY_PATH=/opt/draft-to-blog
DEPLOY_SSH_KEY_PATH=
DEPLOY_DOMAIN=
DEPLOY_SSL_EMAIL=

# ==================== MySQL ====================
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=123456
MYSQL_DATABASE=draft_to_blog
DEFAULT_USER_NAME=demo_user
DEFAULT_USER_DISPLAY_NAME=Demo User
DEFAULT_USER_PASSWORD=123456
DEFAULT_ADMIN_NAME=admin
DEFAULT_ADMIN_DISPLAY_NAME=Administrator
DEFAULT_ADMIN_PASSWORD=admin123456
